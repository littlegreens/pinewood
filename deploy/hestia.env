# Pinewood ù produzione Hestia (path canonici sul VPS)
# Usato da: deploy/deploy-hestia.sh, deploy/pm2/ecosystem.hestia.config.cjs,
#           server/scripts/download-prod-sources.ps1
#
# Non committare segreti qui. Solo path e host.

# SSH
PINWOOD_SSH_TARGET="root@217.154.8.51"

# Hestia: utente e dominio legacy (certificati / vhost)
PINWOOD_HESTIA_USER="gabverdini"
PINWOOD_DOMAIN="pinewood.foundly.it"

# Root sito su Hestia (NO .git oggi ù deploy via git clone + sync)
PINWOOD_SITE_ROOT="/home/gabverdini/web/pinewood.foundly.it"
PINWOOD_PUBLIC_HTML="/home/gabverdini/web/pinewood.foundly.it/public_html"
PINWOOD_SERVER="/home/gabverdini/web/pinewood.foundly.it/server"
PINWOOD_UPLOADS="/home/gabverdini/web/pinewood.foundly.it/server/uploads"

# Repository GitHub
PINWOOD_GIT_REPO="https://github.com/littlegreens/pinewood.git"
PINWOOD_GIT_REPO_SSH="git@github.com:littlegreens/pinewood.git"

# Clone Git sul server (setup consigliato; vedi DEPLOY_HESTIA.md)
PINWOOD_GIT_ROOT="/var/www/pinewood"
PINWOOD_GIT_BRANCH="main"

# URL pubblico (link email, PWA)
PINWOOD_OFFICIAL_URL="https://pinewood.to"
PINWOOD_CLIENT_URL="https://pinewood.to"

# PM2
PINWOOD_PM2_APP="pinewood-api"
PINWOOD_API_PORT="3001"
